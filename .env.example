# Server-side settings for api/contact.js — set these in Vercel
# (Project -> Settings -> Environment Variables), never commit real values.

# Where inquiries are stored (MongoDB connection string)
MONGODB_URI=

# Brevo API key (Brevo -> SMTP & API -> API Keys) — without it, inquiries are
# saved but not emailed
BREVO_API_KEY=

# Who receives inquiry emails. Comma-separated for several recipients,
# e.g. a@gmail.com,b@gmail.com
CONTACT_TO_EMAIL=

# Sender shown on inquiry emails. Must be a verified sender in Brevo on the
# authenticated syphar.net domain, e.g. Syphar <noreply@syphar.net>
CONTACT_FROM_EMAIL=
