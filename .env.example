# Server-side settings for api/contact.js — set these in Vercel
# (Project -> Settings -> Environment Variables), never commit real values.

# Where inquiries are stored (MongoDB connection string)
MONGODB_URI=

# Resend API key — without it, inquiries are saved but not emailed
RESEND_API_KEY=

# Who receives inquiry emails. Until a domain is verified in Resend, this must
# be the email address the Resend account was created with.
CONTACT_TO_EMAIL=

# Optional: sender address once syphar.net is verified in Resend,
# e.g. Syphar <hello@syphar.net>
CONTACT_FROM_EMAIL=
